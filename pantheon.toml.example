# Copy to pantheon.toml for development; production prefers services.pantheon.
state_dir = "./state"
workspace = "."
# instructions_file = "/var/lib/pantheon/instructions.md"

[discord]
application_id = 123456789012345678
allowed_users = [123456789012345678]

[agent]
model = "openai/gpt-5.6"
compactor_model = "openai/gpt-5-mini"
reasoning = "medium"
view_bytes = 128000
# Model-response cycles per run (root and workers), not individual tool calls.
# 0 disables the cap (default); positive values retain a finite per-run cap.
max_steps = 0
max_subagents = 8
agent_idle_seconds = 3600
request_timeout_seconds = 300
# Total HTTP attempts, including the first; 1 disables retries.
request_max_attempts = 4
# Linear retry waits: 2, 4, 6 seconds with the defaults.
request_backoff_seconds = 2
tool_timeout_seconds = 120
# Full root tools with selective background delegation. Set true for a
# strict coordinator that delegates all execution to workers.
coordinator_root = false
shell_background_after_seconds = 5
max_shell_jobs = 16
shell_timeout_seconds = 3600
show_reasoning = false

# Optional display limits for /context; these do not change inference limits.
# Codex models can use their locally cached CLI metadata instead.
# [agent.context_windows]
# "anthropic/YOUR_MODEL" = 200000 # Replace with the verified model limit.

# Optional independent Claude Code task tool. Install/authenticate the official
# native CLI manually for the service user; Pantheon deliberately does not bundle it.
# [claude]
# enabled = true
# model = "opus"
# effort = "medium"
# max_output_chars = 30000
# allowed_tools = ["Read", "Glob", "Grep"]

[auth]
# Reuse a file-based Codex login; omitted defaults to CODEX_HOME or ~/.codex.
# For a service, sign in separately under its own writable state directory.
# codex_home = "/var/lib/pantheon/.codex"
# codex_cli = "/absolute/path/to/codex" # Bundled by Nix; normally omit.

[web]
# Omit to use the calling agent's provider/model for hosted search. An explicit
# Codex model also lets Anthropic agents search using a ChatGPT subscription.
# search_model = "codex/gpt-5.6-sol"
request_timeout_seconds = 45
search_timeout_seconds = 120
cache_ttl_seconds = 300
max_response_bytes = 2097152
allow_private_network = false

[browser]
max_windows = 16
port_start = 6080
port_end = 6180

[skills]
bundled = true
# Libraries or individual directories with SKILL.md seed the durable library.
directories = []

[curator]
enabled = true
# Omit model/reasoning to inherit this channel's non-GLM main model and effort.
# A GLM chat override keeps the configured non-GLM main model for maintenance.
# If agent.model is GLM, explicitly set curator.model or disable this curator.
# /model kind:curator model:none explicitly opts into main-model inheritance.
# model = "codex/YOUR_MODEL"
# reasoning = "low"
idle_seconds = 300
minimum_steps = 3
# Unicode characters shown for each description in the complete system catalogue.
description_chars = 240
reviewers = 2
# Total running deadline for drafting and review, separate from the idle wait.
timeout_seconds = 900
max_steps = 8
review_steps = 4
max_input_chars = 256000
max_research_calls = 4

# MCP servers are optional; executable packages and credentials are configured
# by the operator. Full transport/access details are in docs/mcp.md.
# [mcp.servers.calendar]
# description = "Personal calendar"
# command = "/absolute/path/to/calendar-mcp-server"
# args = []
# env = { CALENDAR_TOKEN = "PANTHEON_CALENDAR_TOKEN" }
# allowed_channels = [123456789012345678]
# allowed_tools = ["list_events", "create_event"]
# workers = true
# timeout_seconds = 120

# [mcp.servers.remote]
# description = "Remote integration"
# url = "https://your-mcp-service.example/mcp"
# bearer_env = "REMOTE_MCP_TOKEN"

# Optional exact Z.ai Coding Chat Completions endpoint (never general paid fallback).
# Set ZAI_API_KEY in the protected service environment, not here.
# Workers may use zai/glm-5.3 (text) or zai/glm-5.3-flash (images); low/high/max.
# Keep web.search_model on an existing supported hosted-search provider.
[zai]
enabled = false
max_in_flight = 2
max_output_tokens = 16384
