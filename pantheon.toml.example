# Copy to pantheon.toml for development; production prefers services.pantheon.
state_dir = "./state"
workspace = "."
# instructions_file = "/var/lib/pantheon/instructions.md"

[discord]
application_id = 123456789012345678
allowed_users = [123456789012345678]

[agent]
model = "openai/gpt-5.6"
compactor_model = "openai/gpt-5-mini"
reasoning = "medium"
view_bytes = 128000
max_steps = 128
max_subagents = 8
agent_idle_seconds = 3600
request_timeout_seconds = 300
tool_timeout_seconds = 120
# Full root tools with selective background delegation. Set true for a
# strict coordinator that delegates all execution to workers.
coordinator_root = false
shell_background_after_seconds = 5
max_shell_jobs = 16
shell_timeout_seconds = 3600
show_reasoning = false

# Optional display limits for /context; these do not change inference limits.
# Codex models can use their locally cached CLI metadata instead.
# [agent.context_windows]
# "anthropic/YOUR_MODEL" = 200000 # Replace with the verified model limit.

[auth]
# Reuse a file-based Codex login; omitted defaults to CODEX_HOME or ~/.codex.
# For a service, sign in separately under its own writable state directory.
# codex_home = "/var/lib/pantheon/.codex"
# codex_cli = "/absolute/path/to/codex" # Bundled by Nix; normally omit.

[web]
# Omit to use the calling agent's provider/model for hosted search. An explicit
# Codex model also lets Anthropic agents search using a ChatGPT subscription.
# search_model = "codex/gpt-5.6-sol"
request_timeout_seconds = 45
search_timeout_seconds = 120
cache_ttl_seconds = 300
max_response_bytes = 2097152
allow_private_network = false

[browser]
max_windows = 16
port_start = 6080
port_end = 6180

[skills]
bundled = true
# Libraries or individual directories with SKILL.md. Reload on service restart.
directories = []

# MCP servers are optional; executable packages and credentials are configured
# by the operator. Full transport/access details are in docs/mcp.md.
# [mcp.servers.calendar]
# description = "Personal calendar"
# command = "/absolute/path/to/calendar-mcp-server"
# args = []
# env = { CALENDAR_TOKEN = "PANTHEON_CALENDAR_TOKEN" }
# allowed_channels = [123456789012345678]
# allowed_tools = ["list_events", "create_event"]
# workers = true
# timeout_seconds = 120

# [mcp.servers.remote]
# description = "Remote integration"
# url = "https://your-mcp-service.example/mcp"
# bearer_env = "REMOTE_MCP_TOKEN"
